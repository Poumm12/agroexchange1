# ── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site URL (used for password-reset redirect) ──────────────
NEXT_PUBLIC_SITE_URL=https://agroexchange.vercel.app

# ── Email (optional, for transactional emails) ───────────────
RESEND_API_KEY=

# ── News (optional) ──────────────────────────────────────────
# If unset, live Greek agri-news RSS feeds are used automatically.
NEXT_PUBLIC_NEWS_API_KEY=

# ── Weather & Market prices ──────────────────────────────────
# No keys required:
#   • Weather  → Open-Meteo (https://open-meteo.com), no API key.
#   • Prices   → EU Agri-Food Data Portal (public), cached in Supabase.
